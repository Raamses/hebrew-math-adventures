{"type":"before","callId":"call@421","startTime":133877.931,"class":"Frame","method":"evaluateExpression","params":{"expression":"key => {\n    try {\n      const raw = localStorage.getItem(key);\n      if (!raw) return -1;\n      const all = JSON.parse(raw);\n      for (const profileId of Object.keys(all)) {\n        const entry = all[profileId];\n        if (entry && typeof entry.dailyChallengeCorrect === 'number') {\n          return entry.dailyChallengeCorrect;\n        }\n      }\n      return -1;\n    } catch {\n      return -1;\n    }\n  }","isFunction":true,"arg":{"value":{"s":"hebrew-math-daily-progress"},"handles":[]}},"stepId":"pw:api@122","pageId":"page@01780a9abb0bdbe077781ce2203dfe19","beforeSnapshot":"before@call@421"}
