{"type":"before","callId":"call@218","startTime":230594.598,"class":"Frame","method":"evaluateExpression","params":{"expression":"key => {\n    try {\n      const raw = localStorage.getItem(key);\n      if (!raw) return -1;\n      const all = JSON.parse(raw);\n      for (const profileId of Object.keys(all)) {\n        const entry = all[profileId];\n        if (entry && typeof entry.dailyChallengeCorrect === 'number') {\n          return entry.dailyChallengeCorrect;\n        }\n      }\n      return -1;\n    } catch {\n      return -1;\n    }\n  }","isFunction":true,"arg":{"value":{"s":"hebrew-math-daily-progress"},"handles":[]}},"stepId":"pw:api@129","pageId":"page@0496f02865462771b1953b399751c01b","beforeSnapshot":"before@call@218"}
